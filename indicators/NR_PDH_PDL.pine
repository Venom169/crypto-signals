cyc_3min = input.string("60", "فترة الدورة", options=["15", "30", "60", "120", "240", "480", "720", "D"], tooltip=cyc_tt, group="⏱ فريم 3دق")
touch_3min = input.int(2, "عدد اللمسات N", minval=1, maxval=99, group="⏱ فريم 3دق")
tol_3min = input.float(0.003, "تسامح اللمس (%)", step=0.001, minval=0.0, tooltip=tol_tt, group="⏱ فريم 3دق")
cnf_en_3min   = input.bool(false, "🕯 فلتر شمعة التأكيد", tooltip=cnf_tt, group="⏱ فريم 3دق")
cnf_body_3min = input.float(0.5, "🕯 أدنى نسبة الجسم", minval=0.1, maxval=0.9, step=0.05, group="⏱ فريم 3دق")
cnf_wick_3min = input.float(0.5, "🕯 أقصى نسبة الفتيل المعاكس", minval=0.1, maxval=0.9, step=0.05, group="⏱ فريم 3دق")
vol_en_3min   = input.bool(false, "📊 فلتر Volume Spike", group="⏱ فريم 3دق")
vol_len_3min  = input.int(20, "📊 Volume SMA Length", minval=1, group="⏱ فريم 3دق")
vol_mult_3min = input.float(1.5, "📊 Volume Multiplier", minval=0.1, step=0.1, group="⏱ فريم 3دق")
fc_en_3min    = input.bool(false, "⏰ ستوب زمني", tooltip=fc_tt, group="⏱ فريم 3دق")
