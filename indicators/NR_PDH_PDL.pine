tp_range_mult = input.float(0.80, "🎯 معامل TP × مدى الدورة", minval=0.05, step=0.05, group="📏 حجم TP/SL")
sl_range_mult = input.float(1.00, "🛑 معامل SL × مدى الدورة", minval=0.05, step=0.05, group="📏 حجم TP/SL")
min_dist_pct  = input.float(0.05, "⬇️ أدنى مسافة مسموحة (%)", minval=0.001, step=0.01, group="📏 حجم TP/SL")
max_dist_pct  = input.float(0.50, "⬆️ أقصى مسافة مسموحة (%)", minval=0.01, step=0.01, group="📏 حجم TP/SL")

