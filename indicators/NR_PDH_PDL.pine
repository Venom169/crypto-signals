float  confirm_min_body_ratio= is_tf3 ? cnf_body_3min : cnf_body_5min
float  confirm_max_wick_ratio= is_tf3 ? cnf_wick_3min : cnf_wick_5min
bool   enable_volume_filter  = is_tf3 ? vol_en_3min : vol_en_5min
int    volumeLength          = is_tf3 ? vol_len_3min : vol_len_5min
float  volumeMultiplier      = is_tf3 ? vol_mult_3min : vol_mult_5min
bool   enable_time_stop      = is_tf3 ? fc_en_3min : fc_en_5min
int    time_stop_bars        = is_tf3 ? fc_bars_3min : fc_bars_5min

