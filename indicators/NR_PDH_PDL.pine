sl_5min  = input.float(0.15, "Stop Loss % (من سعر الدخول)", step=0.01, minval=0.001, tooltip=pct_tt, group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")
tp_5min  = input.float(0.15, "TP 1 % (من سعر الدخول)",      step=0.01, minval=0.001, tooltip=pct_tt, group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")
cyc_5min = input.string("60", "فترة الدورة", options=["15", "30", "60", "120", "240", "480", "720", "D"], tooltip=cyc_tt, group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")
touch_5min = input.int(2, "عدد اللمسات N", minval=1, maxval=99, group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")
tol_5min = input.float(0.003, "تسامح اللمس (%)", step=0.001, minval=0.0, tooltip=tol_tt, group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")
cnf_en_5min   = input.bool(false, "🕯 فلتر شمعة التأكيد", tooltip=cnf_tt, group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")
cnf_body_5min = input.float(0.5, "🕯 أدنى نسبة الجسم", minval=0.1, maxval=0.9, step=0.05, group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")
cnf_wick_5min = input.float(0.5, "🕯 أقصى نسبة الفتيل المعاكس", minval=0.1, maxval=0.9, step=0.05, group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")
vol_en_5min   = input.bool(false, "📊 فلتر Volume Spike", group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")
vol_len_5min  = input.int(20, "📊 Volume SMA Length", minval=1, group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")
vol_mult_5min = input.float(1.5, "📊 Volume Multiplier", minval=0.1, step=0.1, group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")
fc_en_5min    = input.bool(false, "⏰ ستوب زمني", tooltip=fc_tt, group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")
fc_bars_5min  = input.int(24, "⏰ عدد الشموع قبل الإغلاق", minval=1, group="⏱ فريم 5دق (والافتراضي لأي فريم آخر)")

