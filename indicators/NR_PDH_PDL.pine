//@version=5
// N🤖R — نسخة دورة 60 دقيقة · إعدادات فريم 3دق و 5دق فقط
// منطق: لمس PDH من الأسفل N مرات → لونغ | لمس PDL من الأعلى N مرات → شورت. صفقة واحدة مفتوحة في كل وقت.
// الأهداف (TP/SL) تُحسب كنسبة مئوية (%) من سعر الدخول بدل مبلغ دولار ثابت.
// ملاحظة: أي فريم غير 3دق يستخدم إعدادات مجموعة 5دق.
indicator(" N🤖R+15", overlay=true, max_lines_count=500, max_labels_count=500)

// ═══════════════════════════════════════════════
// إعدادات الفريم
// ═══════════════════════════════════════════════
cyc_tt = "دورة PDH/PDL: عند انقلاب هذه الفترة تُحدَّث الخطوط ويُعاد عدّ اللمسات."
fc_tt  = "⏰ ستوب زمني: يُغلق الصفقة بعد عدد شموع محدد من شمعة الدخول."
cnf_tt = "شمعة التأكيد: للصفقة الشرائية تُشترط شمعة صاعدة بجسم قوي وفتيل علوي صغير، وللبيعية العكس."
tol_tt = "نسبة مئوية من سعر خط PDH/PDL. مثال: الذهب عند 3300 → 0.003% ≈ 0.10$."
pct_tt = "نسبة مئوية من سعر الدخول. مثال: الذهب عند 3300 → 0.15% ≈ 4.95$."

