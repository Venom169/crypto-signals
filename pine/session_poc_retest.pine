//@version=6
// Session POC Retest - نسخة أولى بسيطة
// الفكرة:
//   1) خلال كل جلسة (يوم) نجمع الفوليوم على مستويات السعر (Volume Profile بسيط)
//   2) عند نهاية الجلسة نحسب الـ POC (المستوى الأعلى فوليوم)
//   3) في الجلسة التالية: إذا السعر فوق الـ POC => دعم => أمر شراء معلّق على الـ POC
//                         إذا السعر تحت الـ POC => مقاومة => أمر بيع معلّق على الـ POC
//   4) هدف وستوب بمسافة ثابتة بالسعر (مثلاً 20 دولار)
strategy("Session POC Retest", overlay = true, max_lines_count = 500,
     default_qty_type = strategy.fixed, default_qty_value = 1)

// ===== الإعدادات =====
sessTF   = input.timeframe("D", "فريم الجلسة")
rows     = input.int(50, "عدد صفوف البروفايل", minval = 10, maxval = 200)
tpDist   = input.float(20.0, "الهدف (مسافة سعرية بالدولار)", minval = 0.01)
slDist   = input.float(20.0, "الستوب (مسافة سعرية بالدولار)", minval = 0.01)
oneTrade = input.bool(true, "صفقة واحدة فقط لكل جلسة")
pocColor = input.color(color.orange, "لون خط POC")

if timeframe.in_seconds() >= timeframe.in_seconds(sessTF)
    runtime.error("استخدم فريم أصغر من فريم الجلسة (مثلاً 5m أو 15m)")

// ===== حساب الـ POC من شموع الجلسة =====
// كل شمعة توزّع فوليومها بالتساوي على الصفوف التي يغطيها مداها (من اللو إلى الهاي)
f_poc(array<float> hs, array<float> ls, array<float> vs, float hi, float lo, int n) =>
    float result = na
    if array.size(vs) > 0 and hi > lo
        float step = (hi - lo) / n
        array<float> bins = array.new<float>(n, 0.0)
        for i = 0 to array.size(vs) - 1
            int b0 = math.max(0, math.min(n - 1, int(math.floor((array.get(ls, i) - lo) / step))))
            int b1 = math.max(0, math.min(n - 1, int(math.floor((array.get(hs, i) - lo) / step))))
            float share = array.get(vs, i) / (b1 - b0 + 1)
            for b = b0 to b1
                array.set(bins, b, array.get(bins, b) + share)
        int maxIdx = array.indexof(bins, array.max(bins))
        result := lo + step * (maxIdx + 0.5)
    result

// ===== بيانات الجلسة الحالية =====
var array<float> bH = array.new<float>()
var array<float> bL = array.new<float>()
var array<float> bV = array.new<float>()
var float sHi    = na
var float sLo    = na
var int   sStart = na

// ===== POC الجلسة السابقة (المستوى الذي نتداول عليه) =====
var float poc          = na
var line  pocLine      = na
var int   tradesAtSess = 0

newSess = timeframe.change(sessTF)

if newSess and array.size(bV) > 0
    // انتهت الجلسة السابقة: احسب الـ POC وارسمه
    poc := f_poc(bH, bL, bV, sHi, sLo, rows)
    pocLine := line.new(sStart, poc, bar_index, poc, color = pocColor, width = 2)
    array.clear(bH)
    array.clear(bL)
    array.clear(bV)
    sHi := na
    sLo := na
    tradesAtSess := strategy.closedtrades + strategy.opentrades

if newSess or na(sStart)
    sStart := bar_index

// أضف الشمعة الحالية لبيانات الجلسة
array.push(bH, high)
array.push(bL, low)
array.push(bV, nz(volume))
sHi := na(sHi) ? high : math.max(sHi, high)
sLo := na(sLo) ? low : math.min(sLo, low)

// مدّ خط الـ POC خلال الجلسة الحالية
if not na(pocLine)
    line.set_x2(pocLine, bar_index)

// ===== الدخول =====
tradedThisSess = strategy.closedtrades + strategy.opentrades > tradesAtSess
canTrade = not na(poc) and strategy.position_size == 0 and (not oneTrade or not tradedThisSess)

if canTrade
    if close > poc
        // السعر فوق الـ POC => دعم => شراء عند الرجوع له
        strategy.cancel("Short")
        strategy.entry("Long", strategy.long, limit = poc)
    else if close < poc
        // السعر تحت الـ POC => مقاومة => بيع عند الرجوع له
        strategy.cancel("Long")
        strategy.entry("Short", strategy.short, limit = poc)
else if strategy.position_size == 0
    strategy.cancel_all()

// هدف وستوب (المسافة تُحسب من سعر الدخول)
strategy.exit("XL", from_entry = "Long",  profit = tpDist / syminfo.mintick, loss = slDist / syminfo.mintick)
strategy.exit("XS", from_entry = "Short", profit = tpDist / syminfo.mintick, loss = slDist / syminfo.mintick)

// ===== رسم الهدف والستوب أثناء الصفقة =====
inLong  = strategy.position_size > 0
inShort = strategy.position_size < 0
entryPx = strategy.position_avg_price
plot(inLong ? entryPx + tpDist : inShort ? entryPx - tpDist : na, "الهدف", color.green, 2, plot.style_linebr)
plot(inLong ? entryPx - slDist : inShort ? entryPx + slDist : na, "الستوب", color.red, 2, plot.style_linebr)
